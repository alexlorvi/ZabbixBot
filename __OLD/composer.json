{
    "name": "wog/zbx-bot",
    "description": "Telegram bot for Zabbix monitoring",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.8",
        "intellitrend/zabbixapi": "^3.3",
        "monolog/monolog": "^3.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.2"
    },
    "suggest": {
        "ext-sodium": "Шифрування користувацьких токенів у users/*.key"
    },
    "autoload": {
        "psr-4": {
            "ZbxBot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZbxBot\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse"
    }
}
