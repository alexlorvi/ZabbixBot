{
    "require": {
        "irazasyed/telegram-bot-sdk": "^3.14",
        "monolog/monolog": "^3.8",
        "intellitrend/zabbixapi": "^3.2",
        "symfony/console": "^6.4"
    },
    "require-dev": {
        "symfony/var-dumper": "^6.4",
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "ext-sodium": "Шифрування персональних Zabbix API-токенів у tokens/*.key (config: zabbix.token_key)"
    },
    "autoload": {
        "psr-4": {
            "ZabbixBot\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZabbixBot\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
